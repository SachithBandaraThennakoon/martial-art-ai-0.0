APP_ENV=development
APP_VERSION=development
LOG_LEVEL=INFO
# Optional in development; required for Azure production observability.
APPLICATIONINSIGHTS_CONNECTION_STRING=
DATABASE_URL=postgresql://postgres:password@localhost:5432/martial_art_ai
SECRET_KEY=replace_with_a_long_random_secret_before_production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Shared database-backed abuse controls. Keep a separate random hash key in production.
RATE_LIMIT_HASH_KEY=replace_with_a_separate_long_random_secret
RATE_LIMIT_WRITE_REQUESTS=300
RATE_LIMIT_WRITE_WINDOW_SECONDS=300
WS_MAX_MESSAGE_BYTES=262144
WS_MAX_MESSAGES_PER_SECOND=60
WS_MAX_SESSION_SECONDS=900
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Transactional email for password reset links. Choose azure or resend.
EMAIL_PROVIDER=azure
AZURE_COMMUNICATION_EMAIL_CONNECTION_STRING=endpoint=https://your-resource.communication.azure.com/;accesskey=your_access_key
AZURE_EMAIL_SENDER=DoNotReply@your-managed-domain.azurecomm.net

# Optional Resend alternative. Verify xceed.live before using this sender.
RESEND_API_KEY=your_resend_api_key
PASSWORD_RESET_FROM_EMAIL=XMartialArt <security@xceed.live>

OPENAI_API_KEY=your_openai_api_key

# PayPal backend values
# Use sandbox while testing. Use live values only in production.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id
PAYPAL_STARTER_PLAN_ID=your_starter_plan_id
PAYPAL_PRO_PLAN_ID=your_pro_plan_id
PAYPAL_ELITE_PLAN_ID=your_elite_plan_id
PAYPAL_RECONCILE_BATCH_SIZE=200

# Practice tapes use bounded database storage locally and private Azure Blob
# Storage with managed identity in production.
TAPE_STORAGE_MODE=database
TAPE_STORAGE_ACCOUNT_URL=https://yourstorageaccount.blob.core.windows.net
TAPE_STORAGE_CONTAINER=practice-tapes
TAPE_MAX_BYTES=16777216
TAPE_MAX_FRAMES=9000
TAPE_RETENTION_DAYS=90
TAPE_PRUNE_BATCH_SIZE=200

# Retention cleanup. Final periods require legal review before public launch.
CONTACT_RETENTION_DAYS=365
AUTH_RECORD_RETENTION_DAYS=30
