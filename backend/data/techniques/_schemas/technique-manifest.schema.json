{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "technique-manifest.schema.json",
  "title": "Martial arts tracking technique manifest",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "version",
    "display_name",
    "tracking_profile",
    "initial_state",
    "required_features"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "display_name": {"type": "string", "minLength": 1},
    "tracking_profile": {"type": "string", "minLength": 1},
    "initial_state": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "supported_sides": {
      "type": "array",
      "items": {"enum": ["left", "right"]},
      "uniqueItems": true
    },
    "default_side": {"enum": ["left", "right"]},
    "required_views": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "required_landmarks": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "required_features": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
