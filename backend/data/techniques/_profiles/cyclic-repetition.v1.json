{
  "schema_version": "1.0",
  "id": "cyclic-repetition",
  "version": "1.0.0",
  "session_states": [
    "OUTSIDE_SESSION",
    "READY",
    "ACTIVE",
    "PAUSED",
    "TRACKING_LOST",
    "SESSION_COMPLETE"
  ],
  "repetition_states": [
    "WAITING",
    "REP_STARTED",
    "REP_ACTIVE",
    "REP_COMPLETED",
    "REP_ABORTED"
  ],
  "phase_states": ["ENTRY", "HOLD", "EXIT"],
  "defaults": {
    "confirmation": {
      "min_frames": 3,
      "min_ms": 80
    },
    "tracking_loss_grace_ms": 250,
    "unknown_movement_grace_ms": 400,
    "maximum_repairable_tracking_gap_ms": 180
  }
}
