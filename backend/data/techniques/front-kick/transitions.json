{
  "schema_version": "1.0",
  "transitions": {
    "STANCE": {
      "allowed": ["CHAMBER"]
    },
    "CHAMBER": {
      "allowed": ["EXTENSION"],
      "timeout_ms": 900,
      "timeout_action": "ABORT_REPETITION"
    },
    "EXTENSION": {
      "allowed": ["RECOIL"],
      "timeout_ms": 750,
      "timeout_action": "ABORT_REPETITION"
    },
    "RECOIL": {
      "allowed": ["RECOVERY"],
      "timeout_ms": 850,
      "timeout_action": "ABORT_REPETITION"
    },
    "RECOVERY": {
      "allowed": ["STANCE"],
      "timeout_ms": 1500,
      "timeout_action": "ABORT_REPETITION",
      "completes_repetition": true
    }
  }
}
